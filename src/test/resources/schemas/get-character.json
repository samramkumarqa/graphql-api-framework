{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "GetCharacter response",
  "type": "object",
  "required": ["data"],
  "properties": {
    "errors": { "type": "null" },
    "data": {
      "type": "object",
      "required": ["character"],
      "properties": {
        "character": {
          "type": "object",
          "required": ["id", "name", "status", "species", "type", "gender", "image", "created", "origin", "location", "episode"],
          "properties": {
            "id": { "type": "string", "pattern": "^[0-9]+$" },
            "name": { "type": "string", "minLength": 1 },
            "status": { "enum": ["Alive", "Dead", "unknown"] },
            "species": { "type": "string" },
            "type": { "type": "string" },
            "gender": { "enum": ["Female", "Male", "Genderless", "unknown"] },
            "image": { "type": "string", "pattern": "^https://" },
            "created": { "type": "string" },
            "origin": { "$ref": "#/definitions/ref" },
            "location": { "$ref": "#/definitions/ref" },
            "episode": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "episode"],
                "properties": {
                  "id": { "type": "string" },
                  "episode": { "type": "string", "pattern": "^S[0-9]{2}E[0-9]{2}$" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "definitions": {
    "ref": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
