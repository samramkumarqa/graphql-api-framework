<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Sequential on purpose: the public endpoint rate-limits per IP. -->
<suite name="GraphQL Smoke">
    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.qa.tests"/>
        </packages>
    </test>
</suite>
